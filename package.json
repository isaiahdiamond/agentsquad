{
  "name": "agentsquad",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "hooks",
    "assets",
    "demo"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "mock": "npm run mock -w demo",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
